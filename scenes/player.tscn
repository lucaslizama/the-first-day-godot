[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_g2els"]
radius = 0.3

; floor_snap_length has to exceed the tallest step the character can walk DOWN, or the body leaves
; the floor on every riser. Godot's default is 0.10 m and the stairs before the end line have risers
; up to 0.27 m, so descending them went airborne 8 separate times - and since falling 0.24 m under
; Gravity 20 takes about 9 frames while CheckForFall commits after 5, each one flipped the state to
; airborne and restarted the walk clip. Reported in play as the walk animation constantly
; restarting; the animation code was never at fault.
;
; 0.35 m clears the 0.27 m riser. It also means drops shorter than that no longer register as falls,
; which is the same forgiveness that makes stairs work and is why it is not set larger.
[node name="Player" type="CharacterBody3D" unique_id=969548623]
floor_snap_length = 0.35
script = ExtResource("1_3vyb7")
AnimationPlayerPath = NodePath("AnimationPlayer")

[node name="Collider" type="CollisionShape3D" parent="." unique_id=594285596]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
shape = SubResource("CapsuleShape3D_g2els")

[node name="Model" parent="." unique_id=770356973 instance=ExtResource("2_model")]
transform = Transform3D(-1, 0, -8.742278e-08, 0, 1, 0, 8.742278e-08, 0, -1, 0, 0, 0)

[node name="AnimationPlayer" type="AnimationPlayer" parent="." unique_id=68606290]
root_node = NodePath("../Model")
libraries/ = ExtResource("3_anims")

; Fortunato's own AudioSource, playing step.wav. The walk and run clips call
; PlayStepSound from method tracks at their measured footfalls, and landing plays it
; too - see PlayerCharacter. Kept as a WAV rather than converted: it is 6.5 KB and
; 37 ms, so there is nothing for Ogg to save, and short sounds survive better uncompressed.
[node name="StepSound" type="AudioStreamPlayer3D" parent="." unique_id=1120041755]
stream = ExtResource("4_step")
; The Fortunato group in ObsCourseMixer, +20 dB in its snapshot. That is a large boost and it
; is the original's: footsteps sit well above everything else in Unity's mix, including the
; whispers at 0 dB. See default_bus_layout.tres.
bus = &"Fortunato"

[node name="CameraTargetParent" type="Node3D" parent="." unique_id=1894699775]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.55, 0)

[node name="CameraTarget" type="Node3D" parent="CameraTargetParent" unique_id=822124883]
unique_name_in_owner = true
