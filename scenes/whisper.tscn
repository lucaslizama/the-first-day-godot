[gd_scene load_steps=3 format=3]

; One whisper emitter: the AudioSource plus SoundAttenuationByDeath from Unity, as a
; reusable scene. scenes/whispers.tscn instances 15 of these, one per cluster of
; coworkers, generated by tools/generate_whispers_scene.py.
;
; It used to be instanced from coworkers.tscn, once per Unity coworker GROUP - seven of
; them, all at positive x, which left the 25 coworkers on the left of the level with no
; whisper nearer than 90 m. See tools/verify_whispers.gd.
;
; Settings are the Unity AudioSource's: looping, play on awake, volume 1 before the
; death constant scales it, MaxDistance 500, and logarithmic rolloff - which is
; attenuation_model 0, ATTENUATION_INVERSE_DISTANCE, the model whose falloff is
; unit_size / distance and so matches Unity's minDistance / distance exactly.
;
; unit_size and volume_db are both overwritten by WhisperEmitter.cs from the death
; constant, at _Ready and on every change. The values here are what the emitter
; sounds like with no deaths, so the scene is not misleading when opened on its own.
;
; MinDistance and MaxMinDistance are set per instance by whispers.tscn, sized from each
; cluster's own extent. Unity set them per group and inconsistently - 1/10 on one group,
; 40/45 on another, an order of magnitude apart for the same sound - so those values are
; deliberately not reproduced.

[ext_resource type="AudioStream" path="res://audio/susurro_loko.ogg" id="1_whisper"]
[ext_resource type="Script" path="res://scripts/Gameplay/WhisperEmitter.cs" id="2_script"]

[node name="Whisper" type="AudioStreamPlayer3D"]
stream = ExtResource("1_whisper")
attenuation_model = 0
volume_db = -80.0
unit_size = 1.0
max_distance = 500.0
script = ExtResource("2_script")
MinDistance = 1.0
MaxMinDistance = 10.0
