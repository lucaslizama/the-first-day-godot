; Unity's Fortunato start. Its X is 0, so the diag(-1, 1, 1) conjugation leaves it
; where it was. Check Point 1 sits at (0.17, 1.25, 4.29), a metre above it, because
; respawning drops the player rather than placing them standing.
[node name="Player" type="CharacterBody3D" parent="." groups=["player"] instance=ExtResource("9_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4.018)
script = ExtResource("10_player_script")
CameraBasisPath = NodePath("../Camera")
AnimationPlayerPath = NodePath("AnimationPlayer")

[node name="Camera" type="Camera3D" parent="."]
script = ExtResource("11_camera")
TargetPath = NodePath("../Player/CameraTargetParent/CameraTarget")
IgnoreBodyPath = NodePath("../Player")

; The fade, with GUIFadeEffect's own numbers: 1 s before fading out, 2 s to black at
; 0.5 alpha/s, 1 s before fading back, 0.667 s at 1.5 alpha/s. It starts opaque and
; fades in, as GUIFadeEffect.Start did, so the level opens out of black. The respawn
; chain speeds later fade-ins up to the values Unity set on its first completion.
[node name="UI" type="CanvasLayer" parent="."]

[node name="FadeOverlay" type="ColorRect" parent="UI"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 1)
script = ExtResource("12_fade")
FadeInSpeed = 1.5
FadeOutSpeed = 0.5
FadeInDelay = 1.0
FadeOutDelay = 1.0
FadeInOnReady = true

; The UnityEvent graph that used to live across three prefabs. See RespawnChain.cs.
[node name="RespawnChain" type="Node" parent="."]
script = ExtResource("13_chain")
KillVolumePath = NodePath("../Zones/KillVolume")
FadePath = NodePath("../UI/FadeOverlay")
PlayerPath = NodePath("../Player")
CameraTargetPath = NodePath("../Player/CameraTargetParent/CameraTarget")
FirstZonePath = NodePath("../Zones/TriggerZone1")
FirstZoneCheckpointPath = NodePath("../Zones/Checkpoint2")
SecondZonePath = NodePath("../Zones/TriggerZone2")
SecondZoneCheckpointPath = NodePath("../Zones/Checkpoint3")
