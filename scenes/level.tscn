; Unity's Fortunato start. Its X is 0, so the diag(-1, 1, 1) conjugation leaves it
; where it was. Check Point 1 sits at (0.17, 1.25, 4.29), a metre above it, because
; respawning drops the player rather than placing them standing.
[node name="Player" type="CharacterBody3D" parent="." groups=["player"] instance=ExtResource("9_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4.018)
script = ExtResource("10_player_script")
CameraBasisPath = NodePath("../Camera")
AnimationPlayerPath = NodePath("AnimationPlayer")

[node name="Camera" type="Camera3D" parent="."]
script = ExtResource("11_camera")
TargetPath = NodePath("../Player/CameraTargetParent/CameraTarget")
IgnoreBodyPath = NodePath("../Player")

; The fade, with GUIFadeEffect's own numbers: 1 s before fading out, 2 s to black at
; 0.5 alpha/s, 1 s before fading back, 0.667 s at 1.5 alpha/s. It starts opaque and
; fades in, as GUIFadeEffect.Start did, so the level opens out of black. The respawn
; chain speeds later fade-ins up to the values Unity set on its first completion.
[node name="UI" type="CanvasLayer" parent="."]

[node name="FadeOverlay" type="ColorRect" parent="UI"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 1)
script = ExtResource("12_fade")
FadeInSpeed = 1.5
FadeOutSpeed = 0.5
FadeInDelay = 1.0
FadeOutDelay = 1.0
FadeInOnReady = true

; The credits, from UI.prefab: scrollspeed 3, creditsTime 10, text verbatim. Hidden
; until the ending's fade to black completes, which is what SetActive(true) did.
; anchors_preset 8 centres it, and Unity's slow 30-unit crawl then moves it up from
; there. See Credits.cs for why that is not a full roll.
[node name="Credits" type="Label" parent="UI"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "Credits




Programming:
Lucas Lizama

3D Modeling and Animation:
Ian Genskowsky
Kathya Zuñiga
Fernando Castillo


Concept Art:
Fernando castillo
Kathya Zuñiga

Music:
Guillermo Rojas

Sounds:

www.freesound.org

whisper1.wav by thanvannispen
\"small group whispering.wav\" by speedygonzo
looping-hollow-air-wind.wav by robinhood76"
script = ExtResource("15_credits")
ScrollSpeed = 3.0
CreditsTime = 10.0

; menuPausa from UI.prefab: a full-screen wash at white alpha 0.147 with one centred
; button, 331 x 63, labelled "Salir" in 40 pt at (0.196, 0.196, 0.196). Hidden until
; Escape. process_mode 3 is Always, without which pausing would stop the node that has
; to un-pause - see PauseMenu.cs.
[node name="PausePanel" type="Control" parent="UI"]
process_mode = 3
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Wash" type="ColorRect" parent="UI/PausePanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(1, 1, 1, 0.14705883)

[node name="QuitButton" type="Button" parent="UI/PausePanel"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -165.5
offset_top = -31.5
offset_right = 165.5
offset_bottom = 31.5
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.19607843, 0.19607843, 0.19607843, 1)
theme_override_font_sizes/font_size = 40
text = "Salir"

; TimerZone at the finish line, right at meta_01. Unity had it at world
; (0.02, 12.0, -182.32), conjugated to negate X like every other placement; its
; trigger is a 4 x 4 x 1 box offset (0, 2, 0), so the volume spans the banner's
; opening. Hand-authored, so outside tools/unity_space.py's reach - the X negation
; here is applied by hand and has to stay that way.
[node name="TimerZone" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.02, 12, -182.32)
monitorable = false
script = ExtResource("16_timer")
Delay = 5.0
PlayerPath = NodePath("../Player")
FadePath = NodePath("../UI/FadeOverlay")
CreditsPath = NodePath("../UI/Credits")
ConfettiPath = NodePath("../Confetti")

[node name="Collider" type="CollisionShape3D" parent="TimerZone"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
shape = SubResource("BoxShape3D_timer")

; particleSys_conffeti, 4 m above the FINISH banner. Unity had it at
; (-0.02, 16.22, -183.531) turned 90 degrees about X, conjugated here to negate X; the
; quaternion (0.7071068, 0, 0, 0.7071068) is unchanged by the conjugation because its
; y and z are zero. That turn aims the emitter's local +Z straight down, so the
; confetti rains onto the finish line. Hand-authored, so outside unity_space.py.
[node name="Confetti" parent="." instance=ExtResource("17_confetti")]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, 0.02, 16.22, -183.531)

; Escape toggles the pause overlay. Always-processing for the same reason the panel is.
[node name="PauseMenu" type="Node" parent="."]
process_mode = 3
script = ExtResource("18_pause")
PanelPath = NodePath("../UI/PausePanel")

