[ext_resource type="Sky" path="res://materials/sky_fernandito.tres" id="14_sky"]

; background_mode 2 is Sky. It was 1, a flat near-black colour, while
; mat_skyboxFernandito was unported - invisible indoors, where walls fill the frame,
; but the level's ending is exterior, so the whole climax rendered against void.
;
; ambient_light_source stays 2 (Color) rather than becoming Sky. Unity used Flat
; ambient at (0.2235, 0.2353, 0.2235), which is what these numbers are and what
; shaders/character_lit.gdshader's ambient_color default matches. Deriving ambient
; from the sky instead would relight the entire level off a backdrop Unity never used
; for lighting, so the sky here changes what you see and deliberately not how
; anything is lit.
[sub_resource type="Environment" id="Environment_level"]
background_mode = 2
sky = ExtResource("14_sky")
ambient_light_source = 2
ambient_light_color = Color(0.22352943, 0.23529413, 0.22352943, 1)

[node name="Level" type="Node3D" unique_id=563930531]

[node name="Environment" type="WorldEnvironment" parent="." unique_id=1482451335]
environment = SubResource("Environment_level")

; Conjugated by diag(-1, 1, 1) like every other placement in this level - the
; off-diagonal terms coupling X to Y and Z flip sign, so the sun's direction
; mirrors with the world it lights. This is on top of, not instead of, the 180
; degree turn about Y that Unity's opposite light-emission convention needs; that
; correction is already baked into the columns here. See tools/unity_space.py.
[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1798684195]
transform = Transform3D(-0.866002, 0.463367, 0.187965, -3e-06, -0.375905, 0.926658, 0.50004, 0.802488, 0.325535, 0, 3, 0)
light_color = Color(1, 0.95686275, 0.8392157, 1)
shadow_enabled = true

[node name="PointLight" type="OmniLight3D" parent="." unique_id=1474097611]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.373, 2.194, 4.014)
light_color = Color(0.75086504, 0.7719484, 0.9117647, 1)
light_energy = 2.39
omni_range = 20.0

; Unity's Obstaculos container offset, conjugated: -0.2 in Unity is +0.2 here.
[node name="Shell" type="Node3D" parent="." unique_id=746699252]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.2, 0, 0)
script = ExtResource("3_shell")
ModelKey = "nivel.fbx"

[node name="nivel" parent="Shell" unique_id=1709712449 instance=ExtResource("1_nivel")]

