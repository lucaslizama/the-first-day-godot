; The shell's two materials, referenced by the generated override block at the end of
; this file. Declared by hand so tools/generate_shell_overrides.py never has to edit this
; header - it owns only its own delimited region, and these ids must stay stable.
[ext_resource type="Material" path="res://materials/level_general.tres" id="19_general"]
[ext_resource type="Material" path="res://materials/level_transparent.tres" id="20_transparent"]

; The coworkers' whispers, generated separately from the coworkers themselves - see
; tools/generate_whispers_scene.py.
[ext_resource type="PackedScene" path="res://scenes/whispers.tscn" id="21_whispers"]

; The level's music, 68.4 s looping - see the Music node below.
[ext_resource type="AudioStream" path="res://audio/guille_experimental.ogg" id="22_music"]

; Unity's TimerZone BoxCollider: size 4 x 4 x 1, isTrigger 1.
[sub_resource type="BoxShape3D" id="BoxShape3D_timer"]
size = Vector3(4, 4, 1)

; background_mode 2 is Sky. It was 1, a flat near-black colour, while
; mat_skyboxFernandito was unported - invisible indoors, where walls fill the frame,
; but the level's ending is exterior, so the whole climax rendered against void.
;
; ambient_light_source stays 2 (Color) rather than becoming Sky. Unity used Flat
; ambient at (0.2235, 0.2353, 0.2235), which is what these numbers are and what
; shaders/character_lit.gdshader's ambient_color default matches. Deriving ambient
; from the sky instead would relight the entire level off a backdrop Unity never used
; for lighting, so the sky here changes what you see and deliberately not how
; anything is lit.
[sub_resource type="Environment" id="Environment_level"]
background_mode = 2
sky = ExtResource("14_sky")
ambient_light_source = 2
ambient_light_color = Color(0.22352943, 0.23529413, 0.22352943, 1)

[node name="Level" type="Node3D" unique_id=563930531]

[node name="Environment" type="WorldEnvironment" parent="." unique_id=1482451335]
environment = SubResource("Environment_level")

; Conjugated by diag(-1, 1, 1) like every other placement in this level - the
; off-diagonal terms coupling X to Y and Z flip sign, so the sun's direction
; mirrors with the world it lights. This is on top of, not instead of, the 180
; degree turn about Y that Unity's opposite light-emission convention needs; that
; correction is already baked into the columns here. See tools/unity_space.py.
[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1798684195]
transform = Transform3D(-0.866002, 0.463367, 0.187965, -3e-06, -0.375905, 0.926658, 0.50004, 0.802488, 0.325535, 0, 3, 0)
light_color = Color(1, 0.95686275, 0.8392157, 1)
shadow_enabled = true

[node name="PointLight" type="OmniLight3D" parent="." unique_id=1474097611]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.373, 2.194, 4.014)
light_color = Color(0.75086504, 0.7719484, 0.9117647, 1)
light_energy = 2.39
omni_range = 20.0

; Unity's Obstaculos container offset, conjugated: -0.2 in Unity is +0.2 here.
[node name="Shell" type="Node3D" parent="." unique_id=746699252]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.2, 0, 0)
script = ExtResource("3_shell")

[node name="nivel" parent="Shell" unique_id=1709712449 instance=ExtResource("1_nivel")]

[node name="ShellP2" type="Node3D" parent="." unique_id=1391112274]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -38)
script = ExtResource("3_shell")

[node name="nivel_p2" parent="ShellP2" unique_id=1113251813 instance=ExtResource("2_nivel_p2")]

[node name="Props" parent="." unique_id=1592056883 instance=ExtResource("4_props")]

[node name="Platforms" parent="." instance=ExtResource("5_platforms")]

[node name="Coworkers" parent="." instance=ExtResource("6_coworkers")]

; Silent until the player starts dying; WhisperEmitter drives volume from the death
; constant, which is 0 at level start.
[node name="Whispers" parent="." instance=ExtResource("21_whispers")]

; The Music GameObject from nivelEscena. It carried only a Transform and an AudioSource - no
; script - so nothing in the original ever faded, ducked or restarted it: play on awake, loop,
; volume 1, for as long as the level is open.
;
; An AudioStreamPlayer rather than an AudioStreamPlayer3D, and that is the faithful choice, not
; a simplification: the Unity source has Spatialize 0 and a panLevelCustomCurve that is flat at
; 0, so it was fully 2D. A non-positional player has no attenuation and no panning by
; construction, which is exactly "the same volume everywhere in the level".
;
; Its -5.21 dB lives on the Music bus, not here - see default_bus_layout.tres. Keeping the
; mixer's levels in the mixer means volume_db on this node stays available for anything that
; wants to fade the music later, without that fade having to know the mixer value.
;
; The .ogg import needed loop=true set by hand and reimported; Godot defaults it to false, so
; this would otherwise stop after 68.4 s and never come back.
[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("22_music")
volume_db = 0.0
autoplay = true
bus = &"Music"

[node name="Hammers" parent="." instance=ExtResource("7_hammers")]

[node name="Zones" parent="." instance=ExtResource("8_zones")]

; Unity's Fortunato start. Its X is 0, so the diag(-1, 1, 1) conjugation leaves it
; where it was. Check Point 1 sits at (0.17, 1.25, 4.29), a metre above it, because
; respawning drops the player rather than placing them standing.
[node name="Player" type="CharacterBody3D" parent="." groups=["player"] instance=ExtResource("9_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4.018)
script = ExtResource("10_player_script")
CameraBasisPath = NodePath("../Camera")
AnimationPlayerPath = NodePath("AnimationPlayer")

[node name="Camera" type="Camera3D" parent="."]
script = ExtResource("11_camera")
TargetPath = NodePath("../Player/CameraTargetParent/CameraTarget")
IgnoreBodyPath = NodePath("../Player")

; The fade, with GUIFadeEffect's own numbers: 1 s before fading out, 2 s to black at
; 0.5 alpha/s, 1 s before fading back, 0.667 s at 1.5 alpha/s. It starts opaque and
; fades in, as GUIFadeEffect.Start did, so the level opens out of black. The respawn
; chain speeds later fade-ins up to the values Unity set on its first completion.
[node name="UI" type="CanvasLayer" parent="."]

[node name="FadeOverlay" type="ColorRect" parent="UI"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 1)
script = ExtResource("12_fade")
FadeInSpeed = 1.5
FadeOutSpeed = 0.5
FadeInDelay = 1.0
FadeOutDelay = 1.0
FadeInOnReady = true

; The credits, from UI.prefab: scrollspeed 3, creditsTime 10, text verbatim. Hidden
; until the ending's fade to black completes, which is what SetActive(true) did.
; anchors_preset 8 centres it, and Unity's slow 30-unit crawl then moves it up from
; there. See Credits.cs for why that is not a full roll.
[node name="Credits" type="Label" parent="UI"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "Credits




Programming:
Lucas Lizama

3D Modeling and Animation:
Ian Genskowsky
Kathya Zuñiga
Fernando Castillo


Concept Art:
Fernando castillo
Kathya Zuñiga

Music:
Guillermo Rojas

Sounds:

www.freesound.org

whisper1.wav by thanvannispen
\"small group whispering.wav\" by speedygonzo
looping-hollow-air-wind.wav by robinhood76"
script = ExtResource("15_credits")
ScrollSpeed = 3.0
CreditsTime = 10.0

; menuPausa from UI.prefab: a full-screen wash at white alpha 0.147 with one centred
; button, 331 x 63, labelled "Salir" in 40 pt at (0.196, 0.196, 0.196). Hidden until
; Escape. process_mode 3 is Always, without which pausing would stop the node that has
; to un-pause - see PauseMenu.cs.
[node name="PausePanel" type="Control" parent="UI"]
process_mode = 3
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Wash" type="ColorRect" parent="UI/PausePanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(1, 1, 1, 0.14705883)

[node name="QuitButton" type="Button" parent="UI/PausePanel"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -165.5
offset_top = -31.5
offset_right = 165.5
offset_bottom = 31.5
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.19607843, 0.19607843, 0.19607843, 1)
theme_override_font_sizes/font_size = 40
text = "Salir"

; TimerZone at the finish line, right at meta_01. Unity had it at world
; (0.02, 12.0, -182.32), conjugated to negate X like every other placement; its
; trigger is a 4 x 4 x 1 box offset (0, 2, 0), so the volume spans the banner's
; opening. Hand-authored, so outside tools/unity_space.py's reach - the X negation
; here is applied by hand and has to stay that way.
[node name="TimerZone" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.02, 12, -182.32)
monitorable = false
script = ExtResource("16_timer")
Delay = 5.0
PlayerPath = NodePath("../Player")
FadePath = NodePath("../UI/FadeOverlay")
CreditsPath = NodePath("../UI/Credits")
ConfettiPath = NodePath("../Confetti")

[node name="Collider" type="CollisionShape3D" parent="TimerZone"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
shape = SubResource("BoxShape3D_timer")

; particleSys_conffeti, 4 m above the FINISH banner. Unity had it at
; (-0.02, 16.22, -183.531) turned 90 degrees about X, conjugated here to negate X; the
; quaternion (0.7071068, 0, 0, 0.7071068) is unchanged by the conjugation because its
; y and z are zero. That turn aims the emitter's local +Z straight down, so the
; confetti rains onto the finish line. Hand-authored, so outside unity_space.py.
[node name="Confetti" parent="." instance=ExtResource("17_confetti")]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, 0.02, 16.22, -183.531)

; Escape toggles the pause overlay. Always-processing for the same reason the panel is.
[node name="PauseMenu" type="Node" parent="."]
process_mode = 3
script = ExtResource("18_pause")
PanelPath = NodePath("../UI/PausePanel")

; The UnityEvent graph that used to live across three prefabs. See RespawnChain.cs.
[node name="RespawnChain" type="Node" parent="."]
script = ExtResource("13_chain")
KillVolumePath = NodePath("../Zones/KillVolume")
FadePath = NodePath("../UI/FadeOverlay")
PlayerPath = NodePath("../Player")
CameraTargetPath = NodePath("../Player/CameraTargetParent/CameraTarget")
FirstZonePath = NodePath("../Zones/TriggerZone1")
FirstZoneCheckpointPath = NodePath("../Zones/Checkpoint2")
SecondZonePath = NodePath("../Zones/TriggerZone2")
SecondZoneCheckpointPath = NodePath("../Zones/Checkpoint3")

