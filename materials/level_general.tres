[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; Replaces mat_general, the level's main opaque surface (27 references in
; nivelEscena). Values from
; ../the-first-day-unity/Assets/Prefabs/Level Construction/Models/mat_general.mat.
;
; The material also stored a _Cutoff of 0.5, which shader_general does not
; declare, so it is dropped.

[ext_resource type="Shader" path="res://shaders/level_lit.gdshader" id="1_shader"]

[resource]
resource_name = "mat_general"
shader = ExtResource("1_shader")
shader_parameter/gamma_space = true
shader_parameter/albedo_color = Color(0.4582, 0.522, 0.522, 1)
shader_parameter/ambient_color = Color(0.22352943, 0.23529413, 0.22352943, 1)
shader_parameter/proximity_fade_near = 0.500
shader_parameter/proximity_fade_far = 1.800
