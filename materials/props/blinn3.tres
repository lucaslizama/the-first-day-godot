[gd_resource type="StandardMaterial3D" format=3]

; Ported from blinn3.mat, which used Unity's Standard shader (metallic workflow).
; Roughness is 1 - _Glossiness. Unity ran in Gamma colour space while Godot is
; linear, so this matches the albedo exactly but the shading response only
; approximately - unlike the hand-written shaders, Standard is a full PBR model
; and reproducing it term-by-term is not worth it for prop surfaces.

[resource]
resource_name = "blinn3"
albedo_color = Color(0.07604816, 0.072011, 0.107, 1.0)
metallic = 0
roughness = 0.5
